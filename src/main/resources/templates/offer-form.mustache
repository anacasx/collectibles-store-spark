<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Submit Offer - Collectibles Store</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
<div class="container">
    <h1>Submit Your Offer</h1>

    {{#itemName}}
        <div class="item-info">
            <h2>{{itemName}}</h2>
            <p class="item-price">Current Price: {{itemPrice}}</p>
        </div>
    {{/itemName}}

    <form id="offer-form" action="/offers" method="POST">
        <div class="form-item">
            <label for="itemId" class="form-label">Item ID *</label>
            <input type="text"
                   id="itemId"
                   name="itemId"
                   class="form-input"
                   value="{{itemId}}"
                   required
                   {{#itemId}}readonly{{/itemId}}>
        </div>

        <div class="form-item">
            <label for="name-input" class="form-label">Your Name *</label>
            <input type="text"
                   id="name-input"
                   name="name"
                   class="form-input"
                   placeholder="Enter your full name"
                   required>
        </div>

        <div class="form-item">
            <label for="email-input" class="form-label">Email Address *</label>
            <input type="email"
                   id="email-input"
                   name="email"
                   class="form-input"
                   placeholder="your.email@example.com"
                   required>
        </div>

        <div class="form-item">
            <label for="amount-input" class="form-label">Your Offer (USD) *</label>
            <input type="number"
                   id="amount-input"
                   name="amount"
                   class="form-input"
                   placeholder="0.00"
                   step="0.01"
                   min="0.01"
                   required>
        </div>

        <div class="form-item">
            <button type="submit" class="form-button">Submit Offer</button>
        </div>
    </form>

    <div id="message" class="error-message" style="display: none;"></div>

    <p><a href="/items/view">Back to Items</a> | <a href="/offers/view">View All Offers</a></p>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {
        $("#offer-form").submit(function(event) {
            event.preventDefault();

            let itemId = $("#itemId").val();
            let name = $("#name-input").val();
            let email = $("#email-input").val();
            let amount = $("#amount-input").val();

            if (!itemId || !name || !email || !amount) {
                $("#message").text("Please fill out all fields!").show();
                return;
            }

            $.ajax({
                url: "/offers",
                method: "POST",
                data: {
                    itemId: itemId,
                    name: name,
                    email: email,
                    amount: amount
                },
                success: function(response) {
                    alert("Your offer has been submitted successfully!");
                    $("#offer-form")[0].reset();
                    window.location.href = "/offers/view";
                },
                error: function(jqXHR, textStatus, errorThrown) {
                    let errorMsg = "Error submitting offer";
                    try {
                        let errorData = JSON.parse(jqXHR.responseText);
                        errorMsg = errorData.message || errorMsg;
                    } catch (e) {
                        errorMsg = jqXHR.responseText || errorMsg;
                    }
                    $("#message").text(errorMsg).show();
                }
            });
        });
    });
</script>
</body>
</html>