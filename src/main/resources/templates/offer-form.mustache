<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Submit Offer - {{itemName}}</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/styles-forms.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>
<div class="container">
    <h1>Submit an Offer</h1>

    <div style="background-color: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 30px;">
        <h2 style="margin-top: 0;">Item: {{itemName}}</h2>
        <p><strong>Current Price:</strong> {{itemPrice}}</p>
        <p><strong>Item ID:</strong> <code>{{itemId}}</code></p>
    </div>

    <form id="offer-form" method="POST" action="/offers">
        <input type="hidden" name="id" value="{{itemId}}">

        <div class="form-item">
            <label for="name-input" class="form-label">Your Name *</label>
            <input type="text" id="name-input" name="name" class="form-input" required>
        </div>

        <div class="form-item">
            <label for="email-input" class="form-label">Email Address *</label>
            <input type="email" id="email-input" name="email" class="form-input" required>
        </div>

        <div class="form-item">
            <label for="amount-input" class="form-label">Proposed Amount (USD) *</label>
            <input type="number" id="amount-input" name="amount" class="form-input"
                   step="0.01" min="0.01" required>
        </div>

        <div class="form-item">
            <button type="submit" class="form-button">Submit Offer</button>
        </div>
    </form>

    <div style="margin-top: 30px;">
        <a href="/items/view/{{itemId}}">Back to Item Details</a> |
        <a href="/items/view">Back to Items List</a>
    </div>
</div>

<script src="/js/offer-form.js"></script>
</body>
</html>